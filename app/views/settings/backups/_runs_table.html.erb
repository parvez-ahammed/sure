<%# locals: (runs:) %>
<% if runs.empty? %>
  <p class="text-sm text-secondary"><%= t("settings.backups.runs.empty") %></p>
<% else %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-secondary">
        <tr>
          <th class="text-left py-2 pr-3"><%= t("settings.backups.runs.headers.started") %></th>
          <th class="text-left py-2 pr-3"><%= t("settings.backups.runs.headers.status") %></th>
          <th class="text-left py-2 pr-3"><%= t("settings.backups.runs.headers.trigger") %></th>
          <th class="text-left py-2 pr-3"><%= t("settings.backups.runs.headers.size") %></th>
          <th class="text-left py-2 pr-3"><%= t("settings.backups.runs.headers.duration") %></th>
          <th class="text-left py-2 pr-3"><%= t("settings.backups.runs.headers.filename") %></th>
        </tr>
      </thead>
      <tbody>
        <% runs.each do |run| %>
          <tr class="border-t border-primary">
            <td class="py-2 pr-3"><%= run.started_at ? l(run.started_at, format: :long) : "-" %></td>
            <td class="py-2 pr-3">
              <span class="inline-flex items-center gap-1 <%= run.failed? ? 'text-destructive' : (run.success? ? 'text-success' : 'text-secondary') %>">
                <%= run.status %>
              </span>
            </td>
            <td class="py-2 pr-3"><%= run.trigger %></td>
            <td class="py-2 pr-3"><%= run.byte_size ? number_to_human_size(run.byte_size) : "-" %></td>
            <td class="py-2 pr-3"><%= run.duration_ms ? "#{run.duration_ms} ms" : "-" %></td>
            <td class="py-2 pr-3 text-secondary text-xs"><%= run.filename %></td>
          </tr>
          <% if run.failed? && run.error_message.present? %>
            <tr class="border-t-0">
              <td colspan="6" class="py-1 pl-4 text-xs text-destructive"><%= run.error_message %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
